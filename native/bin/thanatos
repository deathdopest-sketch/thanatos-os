#!/usr/bin/env bash
# thanatos: the Thanatos OS control command.
set -euo pipefail

THANATOS_HOME="${THANATOS_HOME:-$HOME/thanatos-os}"
DATA="${THANATOS_DATA:-$HOME/.local/share/thanatos}"
JOURNAL="$DATA/journal.md"
LANG_DIR="$THANATOS_HOME/native/languages"
WEB_PORT="${THANATOS_WEB_PORT:-4173}"

pink=$'\e[38;2;255;117;206m'; violet=$'\e[38;2;165;107;255m'; mint=$'\e[38;2;93;255;206m'
red=$'\e[38;2;255;47;109m'; dim=$'\e[2m'; off=$'\e[0m'
[ -t 1 ] || { pink=; violet=; mint=; red=; dim=; off=; }

say()  { printf '%s☠%s %s\n' "$pink" "$off" "$*"; }
die()  { printf '%s✗%s %s\n' "$red" "$off" "$*" >&2; exit 1; }

usage() {
  cat <<EOF
${pink}thanatos${off} — Thanatos OS control

  ${violet}doctor${off}                     check toolchains and setup
  ${violet}update${off}                     pull the latest Thanatos, rebuild, restart what's running
  ${violet}lang list${off}                  list language plugins
  ${violet}lang install <name|all>${off}    install a toolchain (node python rust go c vita reaper)
  ${violet}web start|stop|status|open${off} run the Lilly desktop on localhost:$WEB_PORT
  ${violet}shell install|restart|status${off} real terminals for the desktop's Terminal app
  ${violet}stumble install${off}            set up the StumbleChat bridge (opens by itself from the desktop)
  ${violet}stumble start|stop|status|log${off} open/close its Chrome window, check on it
  ${violet}new <kind> <name>${off}          scaffold a project (node python rust go c vita reaper)
  ${violet}log [text]${off}                 add to your learning journal (no text: open in \$EDITOR)
  ${violet}review [days]${off}              show recent journal entries (default 7)
  ${violet}streak${off}                     consecutive days with a journal entry
  ${violet}focus [minutes] [task]${off}     focus timer, logs the session when done (default 25)
  ${violet}learn reaper${off}               open the Necronomicon (Reaper's learning system)
EOF
}

# ---------- doctor ----------
doctor() {
  local ok=0 miss=0
  check_cmd() {
    local name=$1 cmd=$2 flag=${3:---version}
    if command -v "$cmd" >/dev/null 2>&1; then
      printf '  %s✓%s %-10s %s\n' "$mint" "$off" "$name" "$("$cmd" "$flag" 2>&1 | head -1)"
      ok=$((ok + 1))
    else
      printf '  %s✗%s %-10s %smissing%s\n' "$red" "$off" "$name" "$dim" "$off"
      miss=$((miss + 1))
    fi
  }
  say "toolchains"
  check_cmd git git; check_cmd node node; check_cmd python python3; check_cmd uv uv
  check_cmd rust cargo; check_cmd go go version; check_cmd gcc gcc; check_cmd vita vita; check_cmd reaper reaper
  say "workflow"
  check_cmd tmux tmux -V; check_cmd nvim nvim; check_cmd ripgrep rg; check_cmd fzf fzf
  check_cmd starship starship; check_cmd gh gh
  say "setup"
  [ -d "$THANATOS_HOME/.git" ] && printf '  %s✓%s repo       %s\n' "$mint" "$off" "$THANATOS_HOME" \
    || printf '  %s✗%s repo       not at %s (set THANATOS_HOME)\n' "$red" "$off" "$THANATOS_HOME"
  if git config --global user.email >/dev/null; then
    printf '  %s✓%s git user   %s\n' "$mint" "$off" "$(git config --global user.name) <$(git config --global user.email)>"
  else
    printf '  %s✗%s git user   run: git config --global user.name/user.email\n' "$red" "$off"
  fi
  [ -f "$HOME/.ssh/id_ed25519.pub" ] && printf '  %s✓%s ssh key\n' "$mint" "$off" \
    || printf '  %s✗%s ssh key    run: ssh-keygen -t ed25519\n' "$red" "$off"
  say "services"
  local svc
  for svc in "thanatos-web.service $WEB_PORT - desktop" "$SHELL_UNIT ${THANATOS_SHELL_PORT:-4181} health terminal" "$STUMBLE_UNIT ${STUMBLE_BRIDGE_PORT:-4180} health stumble"; do
    # shellcheck disable=SC2086
    set -- $svc
    if service_report "$1" "$2" "$( [ "$3" = - ] || echo "$3")" "$4"; then ok=$((ok + 1)); else miss=$((miss + 1)); fi
  done
  printf '\n%s%d ok, %d missing%s\n' "$dim" "$ok" "$miss" "$off"
  [ "$miss" -gt 0 ] && printf '%sservices not running? thanatos update refreshes and restarts them%s\n' "$dim" "$off"
  return 0
}

# ---------- lang ----------
load_plugin() {
  local file="$LANG_DIR/$1.sh"
  [ -f "$file" ] || die "no plugin '$1' (see: thanatos lang list)"
  unset -f describe check install 2>/dev/null || true
  # shellcheck source=/dev/null
  . "$LANG_DIR/_git.sh"
  # shellcheck source=/dev/null
  . "$file"
}

plugins() { for f in "$LANG_DIR"/[!_]*.sh; do basename "$f" .sh; done; }

lang() {
  case "${1:-list}" in
    list)
      for p in $(plugins); do
        ( load_plugin "$p"
          if check >/dev/null 2>&1; then mark="$mint✓$off"; else mark="$dim·$off"; fi
          printf '  %s %-8s %s\n' "$mark" "$p" "$(describe)" )
      done ;;
    install)
      local target=${2:-}; [ -n "$target" ] || die "usage: thanatos lang install <name|all>"
      local list; if [ "$target" = all ]; then list=$(plugins); else list=$target; fi
      for p in $list; do
        say "installing $p"
        ( load_plugin "$p"; install ) || die "$p failed"
      done
      say "done. open a new shell (or: source ~/.bashrc) to pick up PATH changes" ;;
    *) die "usage: thanatos lang list | install <name|all>" ;;
  esac
}

# ---------- update ----------
# Two steps: pull, then hand over to the freshly pulled copy of this script, so
# the rest of the update always runs the new code.
update() {
  cd "$THANATOS_HOME" || die "repo not at $THANATOS_HOME (set THANATOS_HOME)"
  if [ "${1:-}" != --after-pull ]; then
    command -v npm >/dev/null || die "npm missing: thanatos lang install node, then open a new terminal"
    local head; head=$(git rev-parse HEAD)
    git pull --ff-only || die "git pull failed; commit or stash local changes in $THANATOS_HOME"
    exec "$THANATOS_HOME/native/bin/thanatos" update --after-pull "$head"
  fi
  local before=$2
  changed() { ! git diff --quiet "$before" HEAD -- "$@"; }
  # reinstall only when dependencies changed
  if changed package-lock.json || [ ! -d node_modules ]; then npm ci --no-audit --no-fund; fi
  npm run build || die "build failed (output above)"
  ln -sfn "$THANATOS_HOME/native/bin/thanatos" "$HOME/.local/bin/thanatos"
  if has_unit thanatos-web.service; then install_unit thanatos-web.service; systemctl --user restart thanatos-web.service; say "desktop at http://localhost:$WEB_PORT"
  else web stop >/dev/null; web start; fi

  # StumbleChat bridge: refresh and restart; reopen Chrome if it was open
  if has_unit "$STUMBLE_UNIT"; then
    local chrome_was_open; chrome_was_open=$(curl -fsS "http://127.0.0.1:${STUMBLE_BRIDGE_PORT:-4180}/health" 2>/dev/null | grep -c '"chrome":true' || true)
    if changed native/stumble-bridge/package-lock.json; then stumble install >/dev/null
    else install_unit "$STUMBLE_UNIT"; systemctl --user restart "$STUMBLE_UNIT"; fi
    wait_healthy 4180 || say "StumbleChat bridge didn't come up: thanatos stumble log"
    [ "$chrome_was_open" = 1 ] && stumble start >/dev/null
  elif [ -d native/stumble-bridge/node_modules ]; then
    stumble install   # set up before the background service existed: switch over to it
  fi

  # Shell bridge: install if missing; restart if it changed or isn't running.
  # Restarting it closes every Thanatos terminal, so not from inside one (that
  # would end this update).
  if ! has_unit "$SHELL_UNIT"; then shell install
  elif changed native/shell-bridge native/systemd/user/$SHELL_UNIT native/bin/thanatos-run || ! healthy 4181; then
    install_unit "$SHELL_UNIT"
    if [ -n "${THANATOS_TERMINAL:-}" ]; then
      say "terminal service updated; it switches over next login (or run 'thanatos shell restart', which closes open terminals)"
    else
      systemctl --user restart "$SHELL_UNIT"
      wait_healthy 4181 || say "terminal service didn't come up: thanatos shell status"
    fi
  fi
  say "updated to $(git log -1 --format='%h %s')"
}

# ---------- background services ----------
has_unit() { systemctl --user cat "$1" >/dev/null 2>&1; }
healthy() { curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$1/${2:-health}" 2>/dev/null; }
wait_healthy() { for _ in $(seq 20); do healthy "$@" && return 0; sleep 0.5; done; return 1; }
# One line per service for `thanatos doctor` and the status commands: running,
# or why not, with the last error from its log.
service_report() {
  local unit=$1 port=$2 path=${3:-health} name=$4
  if healthy "$port" "$path"; then printf '  %s✓%s %-10s running\n' "$mint" "$off" "$name"; return 0; fi
  if ! has_unit "$unit"; then printf '  %s✗%s %-10s not installed\n' "$red" "$off" "$name"; return 1; fi
  printf '  %s✗%s %-10s %s, not answering\n' "$red" "$off" "$name" "$(systemctl --user is-active "$unit" 2>/dev/null)"
  journalctl --user -u "$unit" -n 3 --no-pager -o cat 2>/dev/null | sed "s/^/      $dim/;s/\$/$off/"
  return 1
}
# Write a user unit pointing at this repo and (re)load it. Returns non-zero
# where there's no systemd user session.
install_unit() {
  mkdir -p "$HOME/.config/systemd/user"
  sed "s#%h/thanatos-os#$THANATOS_HOME#" "$THANATOS_HOME/native/systemd/user/$1" > "$HOME/.config/systemd/user/$1"
  systemctl --user daemon-reload 2>/dev/null
}

# ---------- shell ----------
# Real terminals for the desktop's Terminal app, so every command works there.
SHELL_UNIT=thanatos-shell.service
shell() {
  local dir="$THANATOS_HOME/native/shell-bridge" port="${THANATOS_SHELL_PORT:-4181}"
  case "${1:-status}" in
    install)
      command -v node >/dev/null || die "node missing: thanatos lang install node"
      command -v python3 >/dev/null || die "python3 missing: sudo apt-get install -y python3"
      (cd "$dir" && npm ci --no-audit --no-fund --silent)
      if install_unit "$SHELL_UNIT" && systemctl --user enable "$SHELL_UNIT" 2>/dev/null && systemctl --user restart "$SHELL_UNIT"; then
        wait_healthy "$port" || { service_report "$SHELL_UNIT" "$port" health terminal; die "terminal service didn't start (details above)"; }
        say "terminal service running. Open (or reopen) the Terminal app on the desktop for a real shell"
      else
        say "installed. No background services here, so run 'node $dir/server.js' to use the Terminal app's shell"
      fi ;;
    restart) systemctl --user restart "$SHELL_UNIT" && say "terminal service restarted" ;;
    status)
      if service_report "$SHELL_UNIT" "$port" health terminal; then :
      elif has_unit "$SHELL_UNIT"; then say "fix it with: thanatos shell restart (or thanatos update)"
      else say "set it up with: thanatos shell install"; fi ;;
    log) journalctl --user -u "$SHELL_UNIT" -n 50 -f ;;
    *) die "usage: thanatos shell install|restart|status|log" ;;
  esac
}

# ---------- web ----------
web() {
  local unit=thanatos-web.service
  have_unit() { systemctl --user cat "$unit" >/dev/null 2>&1; }
  case "${1:-status}" in
    start)
      if have_unit; then systemctl --user start "$unit"
      else
        [ -d "$THANATOS_HOME/dist" ] || (cd "$THANATOS_HOME" && npm run build)
        mkdir -p "$DATA"
        # setsid: own process group, so stop can kill npx and the node child together.
        # The child records its own pid: setsid may fork, so $! isn't the group leader.
        (cd "$THANATOS_HOME" && setsid bash -c 'echo $$ > "$1"; exec npx vite preview --host 127.0.0.1 --port "$2" --strictPort' \
          _ "$DATA/web.pid" "$WEB_PORT" >"$DATA/web.log" 2>&1 < /dev/null &)
      fi
      say "desktop at http://localhost:$WEB_PORT" ;;
    stop)
      if have_unit; then systemctl --user stop "$unit"
      elif [ -f "$DATA/web.pid" ]; then kill -TERM -- "-$(cat "$DATA/web.pid")" 2>/dev/null || true; rm -f "$DATA/web.pid"; fi
      say "desktop stopped" ;;
    status)
      if curl -fsS -o /dev/null "http://127.0.0.1:$WEB_PORT/"; then say "running on http://localhost:$WEB_PORT"
      else say "not running (thanatos web start)"; fi ;;
    open)
      web start >/dev/null
      if command -v garcon-url-handler >/dev/null; then garcon-url-handler "http://localhost:$WEB_PORT"
      else xdg-open "http://localhost:$WEB_PORT" >/dev/null 2>&1 || say "open http://localhost:$WEB_PORT"; fi ;;
    *) die "usage: thanatos web start|stop|status|open" ;;
  esac
}

# ---------- stumble ----------
# The StumbleChat bridge: its own Chrome window holds your rooms open (and answers
# the site's pings), and streams chat + cams to the Stumble Live widget. Installed
# as a background service, it opens Chrome by itself when you open the StumbleChat
# or Stumble Live app, so these commands are mostly for setup and troubleshooting.
STUMBLE_UNIT=thanatos-stumble.service
stumble() {
  local dir="$THANATOS_HOME/native/stumble-bridge" port="${STUMBLE_BRIDGE_PORT:-4180}"
  running() { curl -fsS -o /dev/null "http://127.0.0.1:$port/health" 2>/dev/null; }
  control() { curl -fsS -X POST -H 'X-Thanatos: 1' "http://127.0.0.1:$port/$1" >/dev/null; }
  wait_up() { for _ in $(seq 20); do running && return 0; sleep 0.5; done; return 1; }
  case "${1:-status}" in
    install)
      command -v node >/dev/null || die "node missing: thanatos lang install node"
      if [ "$(uname -m)" != x86_64 ]; then
        # Chrome for Testing has no ARM Linux build; the bridge uses Debian's Chromium instead.
        command -v chromium >/dev/null || sudo apt-get install -y chromium
        (cd "$dir" && PUPPETEER_SKIP_DOWNLOAD=1 npm ci --no-audit --no-fund)
      else
        (cd "$dir" && npm ci --no-audit --no-fund)
      fi
      # A copy started by hand would hold the port; the service takes over from it.
      if [ -f "$DATA/stumble.pid" ]; then kill -TERM -- "-$(cat "$DATA/stumble.pid")" 2>/dev/null || true; rm -f "$DATA/stumble.pid"; sleep 1; fi
      if install_unit "$STUMBLE_UNIT" && systemctl --user enable --now "$STUMBLE_UNIT" 2>/dev/null; then
        say "stumble bridge installed and running in the background"
        say "open StumbleChat or Stumble Live on the desktop and its Chrome window opens for you to sign in"
      else
        say "stumble bridge installed. No background services here, so run 'thanatos stumble start' when you want it"
      fi ;;
    start)
      if ! running; then
        if has_unit "$STUMBLE_UNIT"; then systemctl --user start "$STUMBLE_UNIT"
        else
          [ -d "$dir/node_modules" ] || stumble install
          running || {
            export THANATOS_ORIGINS="${THANATOS_ORIGINS:-http://localhost:$WEB_PORT,http://127.0.0.1:$WEB_PORT}"
            mkdir -p "$DATA"
            (cd "$dir" && setsid bash -c 'echo $$ > "$1"; exec node bridge.js' _ "$DATA/stumble.pid" >"$DATA/stumble.log" 2>&1 < /dev/null &)
          }
        fi
        wait_up || die "bridge didn't start; see: thanatos stumble log"
      fi
      control start || die "couldn't open Chrome; see: thanatos stumble log"
      say "StumbleChat is open in the bridge's Chrome window. Sign in there, then use Stumble Live" ;;
    stop)
      # Closes the Chrome window. The service stays ready for the desktop to reopen it.
      if has_unit "$STUMBLE_UNIT"; then running && control stop; say "StumbleChat window closed (rooms are remembered)"
      else
        if [ -f "$DATA/stumble.pid" ]; then kill -TERM -- "-$(cat "$DATA/stumble.pid")" 2>/dev/null || true; rm -f "$DATA/stumble.pid"; fi
        say "bridge stopped (rooms are remembered for next start)"
      fi ;;
    status)
      if running; then say "running: $(curl -fsS "http://127.0.0.1:$port/health")"
      elif has_unit "$STUMBLE_UNIT"; then say "service installed but not running: systemctl --user status $STUMBLE_UNIT"
      elif [ -d "$dir/node_modules" ]; then say "not running (thanatos stumble start, or thanatos stumble install to have it start by itself)"
      else say "not installed (thanatos stumble install)"; fi ;;
    log)
      if has_unit "$STUMBLE_UNIT"; then journalctl --user -u "$STUMBLE_UNIT" -n 50 -f
      else tail -n 50 -f "$DATA/stumble.log"; fi ;;
    *) die "usage: thanatos stumble install|start|stop|status|log" ;;
  esac
}

# ---------- new ----------
new_project() {
  local kind=${1:-} name=${2:-}
  [ -n "$kind" ] && [ -n "$name" ] || die "usage: thanatos new <node|python|rust|go|c|vita|reaper> <name>"
  [ -e "$name" ] && die "'$name' already exists"
  case "$kind" in
    rust) cargo new --quiet "$name" ;;
    go) mkdir "$name" && (cd "$name" && go mod init "$name" >/dev/null 2>&1 && cat > main.go <<'EOF'
package main

import "fmt"

func main() {
	fmt.Println("risen")
}
EOF
      cat > main_test.go <<'EOF'
package main

import "testing"

func TestTruth(t *testing.T) {
	if 1+1 != 2 {
		t.Fatal("arithmetic is dead")
	}
}
EOF
    ) ;;
    python) mkdir "$name" && (cd "$name" && if command -v uv >/dev/null; then uv init --quiet --package . && uv add --quiet --dev pytest ruff; else
      mkdir -p src tests && echo 'def main() -> None:
    print("risen")' > src/main.py; fi
      mkdir -p tests && printf 'def test_truth():\n    assert 1 + 1 == 2\n' > tests/test_truth.py) ;;
    node) mkdir "$name" && (cd "$name" && npm init -y >/dev/null && npm pkg set type=module scripts.test="node --test" scripts.start="node index.js" >/dev/null \
      && echo 'console.log("risen");' > index.js \
      && printf "import test from 'node:test';\nimport assert from 'node:assert/strict';\n\ntest('truth', () => assert.equal(1 + 1, 2));\n" > index.test.js) ;;
    c) mkdir "$name" && (cd "$name" && printf '#include <stdio.h>\n\nint main(void) {\n    puts("risen");\n    return 0;\n}\n' > main.c \
      && printf 'CFLAGS ?= -Wall -Wextra -Werror -g -fsanitize=address,undefined\n\n%s: main.c\n\t$(CC) $(CFLAGS) -o $@ $<\n\nrun: %s\n\t./%s\n\nclean:\n\trm -f %s\n\n.PHONY: run clean\n' "$name" "$name" "$name" "$name" > Makefile) ;;
    vita) mkdir "$name" && printf '// %s\nbirth dna greeting = "Hello from %s";\nbreathe greeting;\n' "$name" "$name" > "$name/main.vita" ;;
    reaper) mkdir "$name" && printf '# %s\nsoul greeting = "Hello from %s";\nharvest greeting;\n' "$name" "$name" > "$name/main.reaper" ;;
    *) die "unknown kind '$kind' (node python rust go c vita reaper)" ;;
  esac
  [ -d "$name/.git" ] || git -C "$name" init --quiet
  [ -f "$name/README.md" ] || printf '# %s\n\nWhat this is, how to run it, what I learned building it.\n' "$name" > "$name/README.md"
  say "created $kind project ./$name"
  journal_add "started $kind project: $name"
}

# ---------- journal ----------
journal_add() {
  mkdir -p "$DATA"
  local today; today=$(date +%F)
  grep -q "^## $today" "$JOURNAL" 2>/dev/null || printf '\n## %s\n' "$today" >> "$JOURNAL"
  printf -- '- %s %s\n' "$(date +%H:%M)" "$*" >> "$JOURNAL"
}

log_cmd() {
  if [ $# -gt 0 ]; then journal_add "$*"; say "logged"
  else mkdir -p "$DATA"; journal_add "(entry)"; "${EDITOR:-nano}" "$JOURNAL"; fi
}

review() {
  local days=${1:-7} since
  [ -f "$JOURNAL" ] || die "journal is empty (thanatos log \"what I learned\")"
  since=$(date -d "-$days days" +%F)
  awk -v since="$since" '/^## /{show = ($2 >= since)} show' "$JOURNAL"
}

streak() {
  local n=0 d
  [ -f "$JOURNAL" ] || { say "streak: 0 day(s)"; return; }
  d=$(date +%F)
  grep -q "^## $d" "$JOURNAL" || d=$(date -d yesterday +%F)
  while grep -q "^## $d" "$JOURNAL"; do n=$((n + 1)); d=$(date -d "$d -1 day" +%F); done
  say "streak: $n day(s)"
}

nudge() {
  # Called from the shell rc: at most one reminder per day.
  local stamp="$DATA/.nudged" today; today=$(date +%F)
  [ "$(cat "$stamp" 2>/dev/null)" = "$today" ] && return 0
  mkdir -p "$DATA"; echo "$today" > "$stamp"
  grep -q "^## $today" "$JOURNAL" 2>/dev/null && return 0
  printf '%s☠ nothing in the journal today. thanatos log "what I learned"%s\n' "$dim" "$off"
}

focus() {
  local mins=${1:-25}; shift || true
  local task=${*:-focus}
  [[ "$mins" =~ ^[0-9]+$ ]] || die "usage: thanatos focus [minutes] [task]"
  say "focusing on '$task' for $mins min (ctrl-c to abandon)"
  local end=$(( $(date +%s) + mins * 60 ))
  while [ "$(date +%s)" -lt "$end" ]; do
    local left=$(( end - $(date +%s) ))
    printf '\r  %s%02d:%02d%s ' "$violet" $((left / 60)) $((left % 60)) "$off"
    sleep 1
  done
  printf '\r'
  command -v notify-send >/dev/null && notify-send "Thanatos" "$task: time's up" || printf '\a'
  journal_add "focus ${mins}m: $task"
  say "done. logged ${mins}m on '$task'"
}

learn() {
  case "${1:-}" in
    reaper) command -v reaper >/dev/null || die "install first: thanatos lang install reaper"; exec reaper --necronomicon ;;
    *) die "usage: thanatos learn reaper" ;;
  esac
}

cmd=${1:-help}; shift || true
case "$cmd" in
  doctor) doctor ;;
  update) update "$@" ;;
  lang) lang "$@" ;;
  web) web "$@" ;;
  shell) shell "$@" ;;
  stumble) stumble "$@" ;;
  new) new_project "$@" ;;
  log) log_cmd "$@" ;;
  review) review "$@" ;;
  streak) streak ;;
  focus) focus "$@" ;;
  learn) learn "$@" ;;
  nudge) nudge ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
