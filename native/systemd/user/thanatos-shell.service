[Unit]
Description=Thanatos shell bridge (real terminals for the desktop's Terminal app)
After=default.target

[Service]
Type=simple
# Installers rewrite this path to the repo location.
WorkingDirectory=%h/thanatos-os/native/shell-bridge
# thanatos-run puts your fnm-managed node on PATH (services don't read ~/.bashrc).
# Each terminal it opens is a normal login shell.
ExecStart=%h/thanatos-os/native/bin/thanatos-run node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
