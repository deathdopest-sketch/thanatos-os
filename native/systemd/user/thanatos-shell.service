[Unit]
Description=Thanatos shell bridge (real terminals for the desktop's Terminal app)
After=default.target

[Service]
Type=simple
# Installers rewrite this path to the repo location.
WorkingDirectory=%h/thanatos-os/native/shell-bridge
# Login shell for fnm-managed node; each terminal it opens is a login shell too.
ExecStart=/bin/bash -lc 'exec node server.js'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
