[Unit]
Description=Thanatos StumbleChat bridge (opens its Chrome window when the desktop asks)
After=default.target sommelier@0.service sommelier-x@0.service

[Service]
Type=simple
# Installers rewrite this path to the repo location.
WorkingDirectory=%h/thanatos-os/native/stumble-bridge
# thanatos-run puts your fnm-managed node on PATH (services don't read ~/.bashrc).
# Chrome needs the display; these are Crostini's defaults when the session
# doesn't already provide them.
ExecStart=/bin/bash -c 'export DISPLAY="$${DISPLAY:-:0}" WAYLAND_DISPLAY="$${WAYLAND_DISPLAY:-wayland-0}"; exec %h/thanatos-os/native/bin/thanatos-run node bridge.js'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
