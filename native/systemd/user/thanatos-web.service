[Unit]
Description=Thanatos OS web desktop (Lilly) on localhost
After=default.target

[Service]
Type=simple
# Installers rewrite this path to the repo location.
WorkingDirectory=%h/thanatos-os
# thanatos-run puts your fnm-managed node on PATH (services don't read ~/.bashrc).
ExecStart=%h/thanatos-os/native/bin/thanatos-run npx vite preview --host 127.0.0.1 --port 4173 --strictPort
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
